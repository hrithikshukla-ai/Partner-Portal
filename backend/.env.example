PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=academia_partner_portal

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

DEFAULT_CURRENCY=USD

FRONTEND_URL=http://localhost:5173

# SMTP for outgoing email (activation links, user creation, password resets).
# When left blank, emails are logged to the backend console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@academia-portal.local

# Single sign-on via Google. Leave blank to keep SSO disabled (the login page
# hides the button automatically). Create these in Google Cloud Console >
# APIs & Services > Credentials > OAuth Client ID (type: Web application),
# with authorized redirect URI = <API base>/api/auth/sso/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/sso/google/callback
